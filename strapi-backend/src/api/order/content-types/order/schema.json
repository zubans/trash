{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order",
    "description": "Waste Removal Order schema"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "customer_id": {
      "type": "integer",
      "required": true
    },
    "executor_id": {
      "type": "integer"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "SEARCHING",
        "ASSIGNED",
        "EXECUTED",
        "COMPLETED",
        "CANCELED"
      ],
      "default": "SEARCHING",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "HOUSEHOLD",
        "CONSTRUCTION",
        "LARGE_ITEMS",
        "HAZARDOUS"
      ],
      "default": "HOUSEHOLD",
      "required": true
    },
    "address": {
      "type": "string",
      "required": true
    },
    "latitude": {
      "type": "float"
    },
    "longitude": {
      "type": "float"
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "photo_urls": {
      "type": "json"
    },
    "sla_deadline": {
      "type": "datetime"
    }
  }
}
