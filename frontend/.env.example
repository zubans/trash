# Backend API URL used by Vite. Must start with VITE_ to be exposed to the client.
# For the web build the frontend is served behind an nginx reverse proxy on
# port 443/8443, so API calls should use the same origin.
VITE_API_URL=https://94.103.9.172:8443

# Debug mode: show detailed error info (request URL, error message) in the app UI
VITE_DEBUG=false
