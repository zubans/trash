# Backend API URL used when building the Android app.
# Production server: use nginx on port 8443 (same as the web app).
# Local emulator + docker-compose.yml: use http://10.0.2.2:8089 (MOBILE_HTTP_ADDR).
VITE_API_URL=http://94.103.9.172:8089

# Debug mode: show detailed error info (request URL, error message) in the app UI
VITE_DEBUG=true
