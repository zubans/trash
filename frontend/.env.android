# Backend API URL used when building the Android app
# 10.0.2.2 is the host loopback address for the Android emulator.
# For a real device replace this with the IP address of your backend on the same network.
VITE_API_URL=https://94.103.9.172:8088

# Debug mode: show detailed error info (request URL, error message) in the app UI
VITE_DEBUG=true
