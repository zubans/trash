# Backend API URL used when building the Android app.
# 10.0.2.2 is the host loopback address for the Android emulator (docker-compose.yml).
# For a real device use http://<server-ip>:8089 (docker-compose.prod.yml exposes 8089:8081).
# Do NOT use https://<server-ip>:8443 on Android unless a valid trusted certificate is installed.
VITE_API_URL=http://94.103.9.172:8089

# Debug mode: show detailed error info (request URL, error message) in the app UI
VITE_DEBUG=true
