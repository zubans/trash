# Backend API URL used by the web app and as a default for local development
# When running behind the nginx reverse proxy, the web frontend calls the
# same origin (port 443/8443) and nginx proxies API requests to the backend.
VITE_API_URL=https://moya-usluga.ru

# Polling interval in seconds for automatic data refreshes
VITE_POLL_INTERVAL_SEC=15
