      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(healthlogin_http_requests_total[5m]))",
          "legendFormat": "",
          "refId": "A",
          "instant": false
        }
      ],
      "description": "Суммарная частота обработанных запросов по всем маршрутам.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
