        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(time() - vless_probe_last_pass_timestamp_seconds) / 60",
          "legendFormat": "",
          "refId": "E",
          "instant": false
