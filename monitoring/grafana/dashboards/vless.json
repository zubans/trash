{
  "uid": "healthlogin-vless",
  "title": "Healthlogin · Резервный VPN-канал",
  "description": "VLESS-туннели, через которые приложение достаёт API, когда прямой путь закрыт. Проверяется от выдачи списка до реального запроса через туннель.",
  "tags": [
    "healthlogin",
    "vless",
    "vpn"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "type": "row",
      "title": "Состояние резервного канала",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Рабочих endpoint'ов",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "vless_endpoints_usable",
          "legendFormat": "",
          "refId": "A",
          "instant": false
        }
      ],
      "description": "Сколько серверов реально пропустили запрос до API. Ноль — резервного канала нет.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Всего в списке",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
