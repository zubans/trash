{
  "version": 1,
  "configs": [
    {
      "remarks": "🇫🇮 Example xhttp/TLS",
      "log": { "loglevel": "warning" },
      "outbounds": [
        {
          "tag": "proxy",
          "protocol": "vless",
          "settings": { "address": "REPLACE-WITH-SERVER-HOST", "port": 443, "id": "REPLACE-WITH-YOUR-VLESS-UUID", "encryption": "none" },
          "streamSettings": {
            "network": "xhttp",
            "security": "tls",
            "xhttpSettings": { "mode": "auto", "path": "/REPLACE-WITH-XHTTP-PATH", "host": "REPLACE-WITH-SERVER-HOST" },
            "tlsSettings": { "serverName": "REPLACE-WITH-SERVER-HOST", "fingerprint": "chrome", "alpn": ["h2"], "allowInsecure": false }
          }
        },
        { "tag": "block", "protocol": "blackhole", "settings": { "response": { "type": "none" } } },
        { "tag": "direct", "protocol": "freedom", "settings": {} }
      ]
    },
    {
      "remarks": "🇳🇱 Example Reality (by IP)",
      "log": { "loglevel": "warning" },
      "outbounds": [
        {
          "tag": "proxy",
          "protocol": "vless",
          "settings": { "address": "REPLACE-WITH-SERVER-IP", "port": 443, "id": "REPLACE-WITH-YOUR-VLESS-UUID", "encryption": "none", "flow": "xtls-rprx-vision" },
          "streamSettings": {
            "network": "tcp",
            "security": "reality",
            "tcpSettings": { "header": { "type": "none" } },
            "realitySettings": { "serverName": "REPLACE-WITH-DECOY-SNI", "fingerprint": "qq", "shortId": "REPLACE-SHORT-ID", "publicKey": "REPLACE-WITH-REALITY-PUBLIC-KEY", "spiderX": "" }
          }
        },
        { "tag": "block", "protocol": "blackhole", "settings": { "response": { "type": "none" } } },
        { "tag": "direct", "protocol": "freedom", "settings": {} }
      ]
    },
    {
      "remarks": "🇷🇺 Example Reality (by host)",
      "log": { "loglevel": "warning" },
      "outbounds": [
        {
          "tag": "proxy",
          "protocol": "vless",
          "settings": { "address": "REPLACE-WITH-SERVER-HOST", "port": 443, "id": "REPLACE-WITH-YOUR-VLESS-UUID", "encryption": "none", "flow": "xtls-rprx-vision" },
          "streamSettings": {
            "network": "tcp",
            "security": "reality",
            "tcpSettings": { "header": { "type": "none" } },
            "realitySettings": { "serverName": "REPLACE-WITH-DECOY-SNI", "fingerprint": "safari", "shortId": "REPLACE-SHORT-ID", "publicKey": "REPLACE-WITH-REALITY-PUBLIC-KEY", "spiderX": "" }
          }
        },
        { "tag": "block", "protocol": "blackhole", "settings": { "response": { "type": "none" } } },
        { "tag": "direct", "protocol": "freedom", "settings": {} }
      ]
    }
  ]
}
