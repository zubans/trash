# Локальное окружение для docker-compose.local.yml.
# Скопируйте в .env.local и при желании поменяйте значения:
#
#   cp .env.local.example .env.local
#
# Все значения ниже — рабочие дефолты для локальной разработки: стек поднимается
# без правок. Файл .env.local в .gitignore, коммитить его нельзя.
#
# ВНИМАНИЕ: это НЕ продакшен-значения. Деплой на сервер по-прежнему использует
# .env (шаблон — .env.deploy.example), этот файл на сервер не попадает.

# --- База данных -----------------------------------------------------------
# Используются и Postgres'ом при инициализации, и бэкендом, и postgres-exporter'ом.
DB_USER=healthlogin
DB_PASSWORD=healthlogin
DB_NAME=healthlogin

# Порт Postgres на хосте (только 127.0.0.1) — для psql, IDE и go-утилит.
# Поменяйте, если 5432 уже занят локальным Postgres'ом.
LOCAL_DB_PORT=5432

# --- Бэкенд ----------------------------------------------------------------
# Ключ подписи access-токенов. Для локальной разработки подойдёт любой,
# но лучше сгенерировать свой: openssl rand -base64 48
JWT_SECRET=local-dev-jwt-secret-not-for-production

# Origin'ы для CORS и WebSocket (через запятую).
CORS_ORIGIN=https://localhost:8443

# Базовый URL, который попадает в письма (подтверждение почты и т.п.).
APP_BASE_URL=https://localhost:8443

# Ключ DaData для подсказок адресов. Можно оставить пустым: стек поднимется,
# но /geo/suggest будет отвечать 503, а регистрация до конца не пройдёт.
DADATA_API_KEY=

# Отправитель писем. Письма наружу не уходят — их ловит Mailpit (см. ниже),
# поэтому адрес может быть любым.
SMTP_FROM=system@localhost

# --- Мониторинг ------------------------------------------------------------
# Локальный стек поднимает Prometheus + Grafana + экспортеры БД и nginx.
# Alertmanager, ops-бот и Telegram здесь намеренно отсутствуют.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Ключ шифрования паспортов: 32 случайных байта в base64
# (openssl rand -base64 32). Без него приём паспортов выключен. Потерять ключ —
# потерять все паспорта: храните копию вне сервера.
PASSPORT_ENC_KEY=
PASSPORT_KEY_VERSION=1
