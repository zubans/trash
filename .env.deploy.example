# Deployment environment variables for docker-compose.prod.yml
# Copy to /opt/healthlogin/.env on the server and fill in real values.

DOCKER_USERNAME=yourdockerhubuser
DB_USER=healthlogin
DB_PASSWORD=change-me-strong-password
DB_NAME=healthlogin
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-long-random-secret
BACKEND_TAG=latest
FRONTEND_TAG=latest
