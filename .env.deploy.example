# Deployment environment variables for docker-compose.
# Copy to /opt/healthlogin/.env on the server and fill in real values.
# The real .env file must never be committed — it is in .gitignore.

DOCKER_USERNAME=yourdockerhubuser
BACKEND_TAG=latest
FRONTEND_TAG=latest

# Database. The port is not published; these credentials are used inside the
# compose network only.
DB_USER=healthlogin
DB_PASSWORD=change-me-strong-password
DB_NAME=healthlogin

# Browser origins allowed for CORS and for WebSocket upgrades (comma separated).
CORS_ORIGIN=https://moya-usluga.ru

# Signing key for access tokens. Generate with: openssl rand -base64 48
# Rotating it invalidates every issued token.
JWT_SECRET=change-me-long-random-secret

# Mail transport. Without SMTP_HOST no verification or reset mail is sent.
SMTP_HOST=mailserver
SMTP_PORT=587
SMTP_USER=system@moya-usluga.ru
SMTP_PASSWORD=change-me
SMTP_FROM=system@moya-usluga.ru
APP_BASE_URL=https://moya-usluga.ru
