# Deployment environment variables for docker-compose.
# Copy to /opt/healthlogin/.env on the server and fill in real values.
# The real .env file must never be committed — it is in .gitignore.

DOCKER_USERNAME=yourdockerhubuser
BACKEND_TAG=latest
FRONTEND_TAG=latest

# Database. The port is not published; these credentials are used inside the
# compose network only.
DB_USER=healthlogin
DB_PASSWORD=change-me-strong-password
DB_NAME=healthlogin

# Browser origins allowed for CORS and for WebSocket upgrades (comma separated).
CORS_ORIGIN=https://moya-usluga.ru

# Signing key for access tokens. Generate with: openssl rand -base64 48
# Rotating it invalidates every issued token.
JWT_SECRET=change-me-long-random-secret

# Mail transport. Without SMTP_HOST no verification or reset mail is sent.
SMTP_HOST=mailserver
SMTP_PORT=587
SMTP_USER=system@moya-usluga.ru
SMTP_PASSWORD=change-me
SMTP_FROM=system@moya-usluga.ru
APP_BASE_URL=https://moya-usluga.ru


#DaData key
DADATA_API_KEY=

# --- Performance tuning ----------------------------------------------------
# Everything below is OPTIONAL. Each variable has a working default compiled
# into the backend, and the stack starts and behaves correctly with the whole
# block left empty or deleted. Values are shown as the defaults, so a line kept
# as-is changes nothing — set one only when a measurement says to.
#
# These were introduced together with the load-related work; the reasoning for
# each default is in the code next to where it is read.

# Upper bound on database connections this process opens.
#
# The bound matters more than the number: without one, a client surge opens
# connections until Postgres refuses them outright, which is an outage rather
# than a queue. With one, the queue forms inside the process and is visible in
# the pool metrics (go_sql_wait_count_total, go_sql_wait_duration_seconds_total)
# — watch those under load before changing this.
#
# Must stay well below the database's max_connections (200, set in
# docker-compose.yml), which also has to cover the workers, a migration run,
# psql and the postgres_exporter.
DB_MAX_OPEN_CONNS=25

# How long the authenticated user (with roles) is cached per request path.
#
# A ban still takes effect immediately: banning revokes the session, and token
# revocation is checked before this cache. What the TTL delays is a role or
# verification change reaching an already-signed-in user. Keep it well under the
# client poll interval. Set to 0 to read the user fresh on every request.
AUTH_CACHE_TTL_SEC=5

# How long the system_settings table is cached.
#
# An admin's edit applies to the next request regardless — the cache is written
# through. The TTL only bounds staleness from writes another process made.
SETTINGS_CACHE_TTL_SEC=10

# How long resolved service-catalog nodes are cached.
#
# Same write-through rule: catalog edits made through the admin panel flush this
# immediately. Raise it if the catalog is effectively static.
CATALOG_CACHE_TTL_SEC=60

# Directory of service behaviour scripts, read on top of the copies compiled
# into the binary. Same layout as the source: one directory per behaviour,
# `config.star` (constants) plus `behavior.star` (logic) inside it.
#
# Leave it unset and the binary's own scripts are used, which is what you want
# normally. Point it at /app/behaviors (the image ships the same files there) to
# correct a rule — a reward amount, who may perform a service — without a
# rebuild. A script that fails to compile is logged and skipped, and the nodes
# that name it stop being orderable until it is fixed.
# BEHAVIORS_DIR=/app/behaviors

# Ceiling on simultaneous requests to DaData.
#
# The HTTP timeout bounds one request, not how many are in flight. When the
# provider slows down, every keystroke from every user starts another call, and
# the pile grows for as long as it stays slow. Past this ceiling address entry
# answers 429 ("provider busy") instead, which the clients already handle.
DADATA_MAX_CONCURRENCY=8

# --- Monitoring ------------------------------------------------------------
# Used only by docker-compose.monitoring.yml. The application stack starts
# without any of these; the monitoring overlay refuses to start without them.
#
# On the server these live in a SEPARATE file, .env.monitoring, written by the
# deploy-monitoring CI job — this .env is rewritten wholesale by the application
# deploy on every run, and the two jobs are parallel, so anything added here
# would be lost on the next race. Compose is given both files. The block below
# is the template for that second file; keep it here so there is one place to
# read what the monitoring stack needs. See doc/monitoring.md.

# Telegram bot that receives alerts. Create one via @BotFather, then add it to
# the chat and read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
# For a group the id is negative.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Grafana admin password. Generate: openssl rand -base64 24
# Grafana is bound to 127.0.0.1 and reached through an SSH tunnel, but it still
# has a login form — do not leave this at a guessable value.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=admin

# Ops bot (Telegram): forced reconciliation, metrics digest, restart.
#
# Shared secret between the backend and the bot. It gates /internal/* on the
# backend's metrics listener, which is compose-network-only and never proxied by
# nginx. Unset on the backend means those routes are not registered at all.
# Generate: openssl rand -hex 32
OPS_KEY=

# Extra chats and users allowed to command the bot, comma separated.
# TELEGRAM_CHAT_ID above is always allowed; without at least one chat the bot
# refuses to start rather than take orders from whoever finds it.
# OPSBOT_ALLOWED_USERS narrows it further: inside an allowed group chat, only
# these user ids may issue commands. Leave empty to allow every member.
OPSBOT_ALLOWED_CHATS=
OPSBOT_ALLOWED_USERS=

# How long a /restart stays armed waiting for /restart_confirm.
OPSBOT_CONFIRM_WINDOW=2m
OPSBOT_RESTART_TIMEOUT=10m
