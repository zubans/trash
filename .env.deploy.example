# Deployment environment variables for docker-compose.
# Copy to /opt/healthlogin/.env on the server and fill in real values.
# The real .env file must never be committed — it is in .gitignore.

DOCKER_USERNAME=yourdockerhubuser
BACKEND_TAG=latest
FRONTEND_TAG=latest

# Database. The port is not published; these credentials are used inside the
# compose network only.
DB_USER=healthlogin
DB_PASSWORD=change-me-strong-password
DB_NAME=healthlogin

# Browser origins allowed for CORS and for WebSocket upgrades (comma separated).
CORS_ORIGIN=https://moya-usluga.ru

# Signing key for access tokens. Generate with: openssl rand -base64 48
# Rotating it invalidates every issued token.
JWT_SECRET=change-me-long-random-secret

# Mail transport. Without SMTP_HOST no verification or reset mail is sent.
SMTP_HOST=mailserver
SMTP_PORT=587
SMTP_USER=system@moya-usluga.ru
SMTP_PASSWORD=change-me
SMTP_FROM=system@moya-usluga.ru
APP_BASE_URL=https://moya-usluga.ru


#DaData key
DADATA_API_KEY=
# --- VLESS fallback channel (Android) ---
# Access key for GET /api/app/endpoints, sent by the app as the X-App-Key header.
# Must match Secrets.APP_KEY in the Android build.
# Generate: openssl rand -base64 24 | tr -d '/+=' | head -c 32
APP_ENDPOINTS_KEY=s6rNCMbJXDg8q1C3Xsz1mL3KLPQPLyG
# AES-256-GCM key (32 bytes = 64 hex chars) used to encrypt the endpoint payload.
# Must match Secrets.ENC_KEY_HEX in the Android build.
# Generate: openssl rand -hex 32
APP_ENDPOINTS_ENC_KEY=91eaff0c81db619e997beaa411d5180c39ca561e586ada3c7cace00bae9de7fd

# --- Monitoring ------------------------------------------------------------
# Used only by docker-compose.monitoring.yml. The application stack starts
# without any of these; the monitoring overlay refuses to start without them.
#
# On the server these live in a SEPARATE file, .env.monitoring, written by the
# deploy-monitoring CI job — this .env is rewritten wholesale by the application
# deploy on every run, and the two jobs are parallel, so anything added here
# would be lost on the next race. Compose is given both files. The block below
# is the template for that second file; keep it here so there is one place to
# read what the monitoring stack needs. See doc/monitoring.md.

# Telegram bot that receives alerts. Create one via @BotFather, then add it to
# the chat and read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
# For a group the id is negative.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Grafana admin password. Generate: openssl rand -base64 24
# Grafana is bound to 127.0.0.1 and reached through an SSH tunnel, but it still
# has a login form — do not leave this at a guessable value.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=admin

# VLESS fallback prober. The keys are the same ones the backend and the Android
# build use; they are repeated here because the prober fetches the endpoint list
# through the public API exactly as a client does.
PROBE_ENDPOINTS_URL=https://moya-usluga.ru/api/app/endpoints
PROBE_TARGET_URL=https://moya-usluga.ru/health
# One full pass starts an xray process per endpoint, so keep this comfortably
# above the time a pass takes (visible as vless_probe_pass_duration_seconds).
PROBE_INTERVAL=2m
