# Node & Dependencies
node_modules/
strapi-backend/

# Self-signed certificates for local HTTPS development
/certs/
.claude/
.agents/
.skills/
skills-lock.json

# Android release signing material
healthlogin-release.keystore
healthlogin-release.password
healthlogin-app.apk
*.jks
*.keystore
*.apk

# Local environment files: these hold JWT_SECRET, SMTP and registry credentials
# and must never be committed. Use .env.deploy.example as the template.
.env
.env.*
!.env.deploy.example
!.env.local.example
# APK signature metadata
*.apk.idsig

# VLESS client config: client ids are access credentials. The config lives in
# feature/vpn-proxy-fallback and must not come back to main.
vless-endpoints.json
