# Константы ачивки «Марафонец».

# Сколько заказов за календарный месяц её открывают.
TARGET_ORDERS = 50

# Вес. Заметно выше повторяемой мелочи: месяц работы должен стоить месяца работы.
WEIGHT = 100

# Подарок из таблицы gifts. По умолчанию не выдаётся: подарок — это деньги
# платформы, и его включение должно быть отдельным решением админа, а не
# следствием того, что ачивку забыли выключить.
GIFT_CODE = None

# Сколько разных заказчиков обязано быть у исполнителя, чтобы ачивка с подарком
# засчиталась. Пятьдесят заказов от одного и того же человека — это не марафон.
MIN_DISTINCT_CUSTOMERS = 10

CFG_TARGET_ORDERS = "target_orders"
CFG_WEIGHT = "weight"
CFG_GIFT_CODE = "gift_code"
CFG_MIN_DISTINCT_CUSTOMERS = "min_distinct_customers"

EVENT_ORDER_CONFIRMED = "order.confirmed"

MSG_SUBJECT = "Марафонец месяца"
MSG_TEXT = "🏃 50 заказов за месяц. +100 баллов к уровню."
