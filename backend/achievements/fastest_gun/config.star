# Константы ачивки «Самый быстрый стрелок на Диком Западе».

# Окно от создания заказа до его подтверждения, в минутах.
WINDOW_MINUTES = 20

# Вес одной выдачи. Ачивка повторяемая, и она — основной источник баллов:
# уровень набирается десятками быстрых заказов, а не одним подвигом.
WEIGHT = 5

# Заказ дешевле этого не считается.
MIN_ORDER_AMOUNT = 300

# Сколько живут баллы этой выдачи, в днях. 0 — вечно.
#
# Ноль и здесь осознан: баллы за быстроту — заработанные, а не акционные. Для
# акции заводится отдельная ачивка с коротким сроком и повышенным весом, и
# именно так временная ачивка отличается от постоянной.
LIFETIME_DAYS = 0

CFG_WINDOW_MINUTES = "window_minutes"
CFG_WEIGHT = "weight"
CFG_MIN_ORDER_AMOUNT = "min_order_amount"
CFG_LIFETIME_DAYS = "lifetime_days"

EVENT_ORDER_CONFIRMED = "order.confirmed"

MSG_SUBJECT = "Самый быстрый стрелок на Диком Западе"
MSG_TEXT = "🤠 Заказ выполнен меньше чем за 20 минут. +5 баллов к уровню."
