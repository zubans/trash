# Константы ачивки «Первое покаяние».
#
# Любую константу ниже админ переопределяет у ачивки через achievements.config
# ключом CFG_* того же смысла. Значение здесь — то, что подставится по умолчанию.

# Вес в баллах. Разовая ачивка, решение бизнеса — 5 баллов.
WEIGHT = 5

CFG_WEIGHT = "weight"

# --- Словарь ядра -------------------------------------------------------------

EVENT_DISPUTE_CONCEDED = "dispute.conceded"

MSG_SUBJECT = "Первое покаяние"
MSG_TEXT = "🤝 Вы признали, что заказ не выполнен, и избавили обе стороны от разбирательства. Штрафной балл не начислен, а вам — 5 баллов к уровню."
