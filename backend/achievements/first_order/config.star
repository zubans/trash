# Константы ачивки «Первый заказ».
#
# Файл отделён от логики намеренно: поменять вес и поменять правило — разные по
# риску правки, и первая не должна требовать чтения второй.
#
# Любую константу ниже админ переопределяет у ачивки через achievements.config
# ключом CFG_* того же смысла. Значение здесь — то, что подставится по умолчанию.

# Вес в баллах. Разовая ачивка — не источник уровня, а знак внимания, но и
# нулём его делать незачем: первый заказ должен что-то стоить.
WEIGHT = 25

# Порог суммы заказа. Ноль означает «границу проводит не сумма»: единственный
# порог платформы живёт в настройке achievement_min_order_amount, и своим числом
# здесь скрипт его больше не дублирует.
#
# Дублирование выглядело осторожностью, а обошлось выключенной ачивкой. Два
# порога отказывают по-разному: ядро пишет в лог, почему заказ не подошёл, а
# скрипт просто возвращает None — молча. Пока оба стояли на 300 ₽ при ценах
# каталога в 100–200 ₽, второй порог не добавлял ни одной проверки, зато делал
# первую невидимой.
#
# Строже ядра ачивка быть по-прежнему вправе: админ ставит ей min_order_amount в
# config, и это значение перекроет ноль.
MIN_ORDER_AMOUNT = 0

# Подарок из таблицы gifts. None — без подарка. Автоматическая выдача денежных
# подарков за разовую ачивку допустима именно потому, что она разовая.
GIFT_CODE = None

CFG_WEIGHT = "weight"
CFG_MIN_ORDER_AMOUNT = "min_order_amount"
CFG_GIFT_CODE = "gift_code"

# --- Словарь ядра -------------------------------------------------------------
# Имена событий так, как их пишет Go. Собраны здесь, чтобы переименование на той
# стороне было одной правкой в одном файле.

EVENT_ORDER_CONFIRMED = "order.confirmed"

MSG_SUBJECT = "Первый заказ выполнен"
MSG_TEXT = "🎉 Поздравляем с первым выполненным заказом! Вам начислено 25 баллов — они снижают комиссию по мере роста уровня."
