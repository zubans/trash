            "url": {
              "raw": "{{baseUrl}}/customer/profile",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "profile"]
            }
          },
          "response": []
        },
        {
          "name": "Create top-up request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCustomer}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customer/finances/topup",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "finances", "topup"]
            }
