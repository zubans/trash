            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCustomer}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chats/{{orderId}}/ws",
              "host": ["{{baseUrl}}"],
              "path": ["chats", "{{orderId}}", "ws"]
            },
            "description": "WebSocket endpoint. Use Postman's WebSocket request type or a dedicated WS client to connect."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCustomer}}"
              }
